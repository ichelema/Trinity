{
  "cleanupPeriodDays": 20,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "API_TIMEOUT_MS": "300000",
    "MCP_TIMEOUT": "60000",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(pnpm *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(python *)",
      "Bash(ruby *)",
      "Bash(ls*)",
      "Bash(sleep *)",
      "Bash(echo *)",
      "Read",
      "mcp__excalidraw__export_scene",
      "mcp__excalidraw__read_diagram_guide",
      "mcp__excalidraw__clear_canvas",
      "mcp__excalidraw__batch_create_elements",
      "mcp__excalidraw__set_viewport",
      "mcp__excalidraw__get_canvas_screenshot",
      "mcp__excalidraw__update_element",
      "mcp__excalidraw__create_from_mermaid",
      "mcp__excalidraw__query_elements",
      "mcp__excalidraw__delete_element",
      "mcp__excalidraw__describe_scene",
      "Edit(/e/obsidian/sinapsi/**)",
      "Bash(start obsidian://adv-uri?vault=* *)",
      "Skill(double-commander-docs)",
      "mcp__obsidian_semantic_notes_vault__vault",
      "mcp__obsidian_semantic_notes_vault__view",
      "mcp__obsidian_semantic_notes_vault__graph",
      "Read(//tmp/**)",
      "Bash(shasum -a 256)",
      "mcp__hindsight__recall",
      "mcp__hindsight__get_bank",
      "mcp__hindsight__list_tags",
      "mcp__hindsight__list_memories"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5[1m]",
  "enableWorkflows": true,
  "enabledPlugins": {},
  "extraKnownMarketplaces": {},
  "outputStyle": "simple",
  "language": "italiano",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "theme": "custom:nord",
  "editorMode": "vim",
  "verbose": false,
  "switchModelsOnFlag": true,
  "fileCheckpointingEnabled": true,
  "terminalProgressBarEnabled": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true
}
