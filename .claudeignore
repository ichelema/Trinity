# File che Claude Code non deve leggere ne' cercare: artefatti di runtime, dati
# generati e output di benchmark. Non sono segreti, sono RUMORE: gonfiano il
# contesto e inquinano i risultati di grep/glob senza aggiungere informazione.
# Sintassi identica a .gitignore.

# --- Log e alert (3.5M in logs/, il solo hindsight-debug.log supera i 2M) ------
logs/
*.log
*-ALERT.txt
*.count

# --- Dati generati e cache ----------------------------------------------------
data/playwright-mcp/
hooks/hindsight/data/
sound/

# --- Output dei benchmark (~5M): i risultati che contano sono nel mise.toml,
#     nei commenti di config e nelle memorie Hindsight, non nei JSON grezzi.
#     ECCEZIONE consapevole: bench_results/baseline-*/ resta leggibile, e' la
#     baseline di confronto per i cambi di embedding.
hooks/hindsight/benchmark/bench_results_rerank/
hooks/hindsight/benchmark/bench_results/embed_*.json
hooks/hindsight/benchmark/bench_results/recall_quality_*/

# --- Cache degli interpreti e dei tool ----------------------------------------
__pycache__/
*.pyc
.ruff_cache/
.ruby-lsp/

# --- Backup e dump del database -----------------------------------------------
*.bak
*.dump
*.sql
