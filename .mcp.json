{
  "mcpServers": {
    "obsidian_semantic_notes_vault": {
      "type": "http",
      "url": "http://localhost:3002/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "${TRINITY_PLUGIN_DIR}/scripts/bin/run-node.sh",
      "args": [
        "npm:@playwright/mcp/cli.js",
        "--browser",
        "${PLAYWRIGHT_MCP_BROWSER:-chrome}",
        "--output-dir",
        "${TEMP:-/tmp}/playwright-mcp"
      ]
    },
    "debugger": {
      "type": "stdio",
      "command": "${TRINITY_PLUGIN_DIR}/scripts/bin/run-node.sh",
      "args": [
        "${MCP_DEBUGGER_DIR}/package/dist/cli.mjs",
        "stdio",
        "--log-file",
        "${TRINITY_PLUGIN_DIR}/logs/mcp-debugger.log"
      ],
      "env": {
        "PYTHONPATH": "${MCP_DEBUGGER_DIR}/pylib",
        "PYTHONUTF8": "1"
      }
    },
    "neovim": {
      "type": "stdio",
      "command": "${TRINITY_PLUGIN_DIR}/scripts/bin/run-node.sh",
      "args": [
        "${MCP_NEOVIM_DIR}/build/index.js"
      ],
      "env": {
        "NVIM_SOCKET_PATH": "${NVIM_SOCKET_PATH:-//./pipe/claude-debug-trinity}"
      }
    },
    "ticktick": {
      "type": "http",
      "url": "https://mcp.ticktick.com/",
      "headers": {
        "Authorization": "Bearer ${TICKTICK_API_KEY}"
      }
    }
  }
}
