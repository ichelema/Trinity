{
  "typescript": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/bin/run-lsp.sh",
    "args": ["typescript-language-server", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mts": "typescript",
      ".cts": "typescript"
    },
    "maxRestarts": 3
  },
  "python": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/bin/run-lsp.sh",
    "args": ["pyright-langserver", "--stdio"],
    "extensionToLanguage": {
      ".py": "python",
      ".pyi": "python"
    },
    "maxRestarts": 3
  },
  "ruby": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/bin/run-lsp.sh",
    "args": ["ruby-lsp"],
    "extensionToLanguage": {
      ".rb": "ruby",
      ".rbw": "ruby",
      ".rake": "ruby",
      ".gemspec": "ruby"
    },
    "maxRestarts": 3
  },
  "lua": {
    "command": "${CLAUDE_PLUGIN_ROOT}/scripts/bin/run-lsp.sh",
    "args": ["lua-language-server"],
    "extensionToLanguage": {
      ".lua": "lua"
    },
    "maxRestarts": 3
  }
}
