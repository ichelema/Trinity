{
  "hooks": {
    "SessionStart": [{
      "matcher": "",
      "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hindsight/hindsight-ensure-up.sh",
          "timeout": 50
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/inject-core-behavior.sh",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/inject-model-behavior.sh",
          "timeout": 5
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hindsight/hindsight-mm-inject.sh",
          "timeout": 25
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claudish/capture-model.sh",
          "timeout": 5
        }
      ]
    }, {
      "matcher": "startup|resume|clear|compact",
      "hooks": [{
          "type": "command",
          "command": "lua \"${CLAUDE_PLUGIN_ROOT}/hooks/ponytail/ponytail-activate.lua\"",
          "timeout": 5,
          "statusMessage": "Loading ponytail mode..."
        }
      ]
    }],
    "SubagentStart": [{
      "hooks": [{
          "type": "command",
          "command": "lua \"${CLAUDE_PLUGIN_ROOT}/hooks/ponytail/ponytail-subagent.lua\"",
          "timeout": 5,
          "statusMessage": "Loading ponytail mode..."
        }
      ]
    }],
    "UserPromptSubmit": [{
      "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/skill-eval/skill-eval.sh",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hindsight/hindsight-recall.sh",
          "timeout": 60
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hindsight/hindsight-failcheck.sh",
          "timeout": 30
        }
      ]
    }, {
      "hooks": [{
          "type": "command",
          "command": "lua \"${CLAUDE_PLUGIN_ROOT}/hooks/ponytail/ponytail-mode-tracker.lua\"",
          "timeout": 5,
          "statusMessage": "Tracking ponytail mode..."
        }
      ]
    }],
    "PostToolUse": [{
      "matcher": "mcp__plugin_trinity_excalidraw__export_scene",
      "hooks": [{
        "type": "command",
        "command": "ruby ${CLAUDE_PLUGIN_ROOT}/hooks/excalidraw/excalidraw-to-obsidian.rb",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "matcher": "",
      "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/play-sound.sh Windows_Proximity_Notification.wav",
          "timeout": 10,
          "async": true
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/hindsight/hindsight-retain.sh",
          "timeout": 10
        }
      ]
    }],
    "Notification": [{
      "matcher": "permission_prompt",
      "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/play-sound.sh Windows_Exclamation.wav",
          "timeout": 10,
          "async": true
        },
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bin/windows-toast.sh",
          "timeout": 10,
          "async": true
        }
      ]
    }],
    "MessageDisplay": [{
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/claudish/gate.sh",
        "timeout": 60
      }]
    }]
  }
}
