# Gli script devono restare LF in QUALSIASI clone: uno shebang con CRLF fa
# fallire l'exec su Linux ("bad interpreter: /usr/bin/env bash^M"). Qui la config
# e' gia' core.autocrlf=false, ma un clone altrove (default di Git for Windows:
# autocrlf=true) convertirebbe il working tree a CRLF. Gli attributi viaggiano
# col repo, la config locale no.
*.sh      text eol=lf
*.py      text eol=lf
*.rb      text eol=lf
*.js      text eol=lf
*.cjs     text eol=lf

# Unit systemd: Linux-only.
*.timer   text eol=lf
*.service text eol=lf

# Gli hook git non hanno estensione ma sono script bash.
.githooks/**  text eol=lf

# Binari: mai convertire.
*.png   binary
*.wav   binary
